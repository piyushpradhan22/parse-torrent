# Environment variables - copy to .env and customize
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# NVIDIA API Key (get from https://build.nvidia.com/endpoints)
NVIDIA_API_KEY=

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=torrent_parser

# Data Paths
IMDB_DATASETS_PATH=./data/imdb
IMDB_INDEX_PATH=./indexer/imdb_index

# Model Configuration
MODEL_NAME=bert-base-uncased
DEVICE=cpu

# Feature Flags
USE_FUZZY_MATCHING=true
FUZZY_THRESHOLD=0.8
